# MapBox public API key
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=""
# Stripe test-mode configuration for the final-bill checkout button.
STRIPE_SECRET_KEY=sk_test_replace_me
# Safe to send to the app: used by the native Stripe PaymentSheet.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Optional: direct the charge to a restaurant's Stripe Connect test account.
STRIPE_MERCHANT_ACCOUNT_ID=acct_replace_me
STRIPE_CURRENCY=nzd
# Use a public HTTPS URL when demonstrating Checkout outside the local network.
STRIPE_SUCCESS_URL=https://example.com/payment-success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://example.com/payment-cancelled
